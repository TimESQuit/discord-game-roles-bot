{
  "plugins": ["typescript", "unicorn", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "eslint/no-await-in-loop": "off",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "import/no-cycle": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/db/**", "!**/db/index.ts"],
            "message": "Import db only through its index.ts (../db/index.ts)."
          },
          {
            "group": ["**/discord/**", "!**/discord/index.ts"],
            "message": "Import discord only through its index.ts (../discord/index.ts)."
          },
          {
            "group": ["**/domain/**", "!**/domain/index.ts"],
            "message": "Import domain only through its index.ts (../domain/index.ts)."
          },
          {
            "group": ["**/services/**", "!**/services/index.ts"],
            "message": "Import services only through its index.ts (../services/index.ts)."
          },
          {
            "group": ["**/interactions/**", "!**/interactions/index.ts"],
            "message": "Import interactions only through its index.ts (../interactions/index.ts)."
          },
          {
            "group": ["**/views/**", "!**/views/index.ts"],
            "message": "Import views only through its index.ts (../views/index.ts)."
          },
          {
            "group": ["**/testing/**", "!**/testing/index.ts"],
            "message": "Import testing only through its index.ts (../testing/index.ts)."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/db/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
